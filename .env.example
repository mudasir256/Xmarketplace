NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by Socket.IO CORS in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Paste these into Supabase → Authentication → Sign In / Providers → Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Auth redirect URLs to allow in Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: http://localhost:3000
# - Redirect URLs: http://localhost:3000/auth/callback
#
# Google Cloud Authorized redirect URI:
# https://<project-ref>.supabase.co/auth/v1/callback

# Database password from Supabase → Settings → Database (for npm run db:chat)
SUPABASE_DB_PASSWORD=
