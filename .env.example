# =============================================================================
# PUBLIC (safe in the browser — prefix MUST stay NEXT_PUBLIC_)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# =============================================================================
# SERVER ONLY — never prefix with NEXT_PUBLIC_
# Add these in Vercel → Project → Settings → Environment Variables
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local only (npm run db:chat). Do NOT add to Vercel.
SUPABASE_DB_PASSWORD=

# Paste into Supabase → Authentication → Providers → Google (not required by Next.js code)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Auth redirect URLs (Supabase Dashboard → Authentication → URL Configuration):
# - Site URL: http://localhost:3000
# - Redirect URLs: http://localhost:3000/auth/callback
# Google Cloud Authorized redirect URI:
# https://<project-ref>.supabase.co/auth/v1/callback
