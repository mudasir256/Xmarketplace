# =============================================================================
# PUBLIC (safe in the browser — prefix MUST stay NEXT_PUBLIC_)
# Copy to .env.local and fill in real values. Never commit real secrets.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias (same value as ANON_KEY):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# =============================================================================
# SERVER ONLY — never prefix with NEXT_PUBLIC_
# Also add these in Vercel → Settings → Environment Variables
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local only (npm run db:chat / db:locations). Do NOT put on Vercel.
SUPABASE_DB_PASSWORD=

# Paste into Supabase → Authentication → Providers → Google
# (not required as Next.js env vars)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
